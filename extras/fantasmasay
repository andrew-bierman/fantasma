#!/usr/bin/env bash
# fantasmasay — a friendly ghost says your words.
# Usage: fantasmasay "boo. terminals should float."
set -euo pipefail
MSG="${*:-boo.}"
FIRST="$(printf '%s\n' "$MSG" | head -1)"
LEN=${#FIRST}
TOP="$(printf '_%.0s' $(seq 1 $((LEN + 2))))"
BOT="$(printf '%s' "$(printf '_%.0s' $(seq 1 $((LEN + 2))))" | tr '_' '¯')"

printf ' %s\n' "$TOP"
printf '< %s >\n' "$FIRST"
printf ' %s\n' "$BOT"
cat <<'ART'
  .-.
 (o o)
 | O \
 /     \
/       \
 `~\_/~'
ART
